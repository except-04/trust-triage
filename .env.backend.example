# 백엔드 .env 설정 예시
# 이 파일에는 항목 이름과 예시만 두고, 실제 연결 정보는 루트의 .env에 작성합니다.
# 처음 한 번 (.env가 없을 때): Copy-Item .env.backend.example .env
# 가상환경을 활성화하고 저장소 루트에서 실행:
#   python -m trust_triage.backend_api --env-file .env check
#   python -m trust_triage.backend_api --env-file .env serve
# 분석 처리기는 별도 터미널에서 실행:
#   python -m trust_triage.backend_api --env-file .env run
# __main__.py가 .env를 환경변수로 불러오고, config.py가 그 값을 읽습니다.
# --env-file을 생략하면 .env를 자동으로 읽지 않습니다.
# 이미 터미널에 설정된 환경변수가 있으면 그 값이 .env보다 우선합니다.

# 1. PostgreSQL — 분석 접수 정보와 결과를 저장하는 DB
# DB 담당자가 알려준 사용자명, 비밀번호, 주소, 포트, DB 이름을 넣습니다.
# 예: postgresql://DB_USER:DB_PASSWORD@DB_HOST:5432/DB_NAME
# 제공받은 주소에 ?sslmode=require 등의 옵션이 있으면 함께 사용합니다.
# URL의 비밀번호에 @, :, / 같은 특수문자가 있으면 URL 인코딩이 필요합니다.
# init-db 명령은 이미 만들어진 DB 안에 테이블을 생성합니다.
BACKEND_DATABASE_URL=

# 2. 원본 파일 저장소 — local은 현재 PC, s3는 AWS S3에 저장
# DB·접수·조회부터 확인할 때는 local로 시작할 수 있습니다.
# AWS에 원본을 저장하려면 s3로 바꾸고 아래 버킷 이름을 채웁니다.
BACKEND_STORAGE_MODE=local
BACKEND_STORAGE_ROOT=artifacts/backend/samples
BACKEND_TEMP_DIR=artifacts/backend/tmp

# 버킷을 만든 AWS 리전으로 변경합니다. ap-northeast-2는 서울입니다.
AWS_REGION=ap-northeast-2
# 버킷 이름만 입력합니다. s3://나 폴더 경로는 붙이지 않습니다.
# 예: trust-triage-dev-samples
BACKEND_S3_BUCKET=
# 버킷 안에서 원본을 저장할 경로. 마지막 /를 포함합니다.
BACKEND_S3_PREFIX=raw/

# 3. AWS 인증 — boto3가 AWS 인증 정보를 읽습니다.
# 팀에서 AWS 프로필이나 서버 IAM 역할을 준비했다면 해당 방식을 사용합니다.
# 로컬 AWS 프로필을 쓸 때만 아래 주석을 풀고 프로필 이름을 입력합니다.
# AWS_PROFILE=trust-triage-dev
# 액세스 키로 연결할 때만 .env에서 아래 두 줄의 주석을 풀고 값을 채웁니다.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# 임시 자격 증명을 발급받았다면 세션 토큰도 함께 입력합니다.
# AWS_SESSION_TOKEN=

# 4. API 서버 — 기본값은 이 PC에서만 접속 가능한 주소
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
# 로컬 개발에서는 비워둘 수 있습니다. 설정할 때는 24자 이상을 사용합니다.
# BACKEND_HOST를 0.0.0.0 등으로 바꾸면 BACKEND_API_TOKEN이 필수입니다.
# API 토큰은 요청의 X-API-Key, 검토 전용 토큰은 X-Reviewer-Key로 보냅니다.
BACKEND_API_TOKEN=
BACKEND_REVIEWER_TOKEN=

# 5. 초기 분석 — run으로 실제 분석을 하려면 아래 6개 경로가 필요합니다.
# 팀에서 검증한 모델과 Feature 산출물의 실제 경로를 넣습니다.
# DB·S3 연결 확인(check)과 API 접수·조회에는 모델 파일이 필요하지 않습니다.
# Windows 경로는 C:/...처럼 /로 쓰면 편합니다. 상대 경로는 실행 폴더 기준입니다.
# LightGBM 모델 (예: artifacts/backend/models/baseline_lgbm.pkl)
BACKEND_LGBM_PATH=
# XGBoost 비교 모델 (예: artifacts/backend/models/baseline_xgb.pkl)
BACKEND_XGB_PATH=
# 확률 보정 산출물 (예: artifacts/backend/models/jrr_calibrator.pkl)
BACKEND_CALIBRATOR_PATH=
# OOD 등 위험 신호 산출물 (예: artifacts/backend/models/risk_signals.pkl)
BACKEND_RISK_SIGNALS_PATH=
# 학습에 사용한 상위 500개 Feature 인덱스 .npy 파일
BACKEND_TOP_INDICES_PATH=
# 위 인덱스와 이름·순서·해시가 일치하는 selection manifest .json 파일
BACKEND_SELECTION_MANIFEST_PATH=

# 6. 크기·시간 제한 — 처음에는 코드의 기본값을 사용하면 됩니다.
# 변경할 항목만 주석을 풀어 사용합니다. 시간 단위는 초입니다.
# BACKEND_MAX_FILE_BYTES=52428800
# BACKEND_MAX_BATCH_FILES=10
# ZIP 입력: 압축 파일 50 MiB, 폴더 포함 100항목, 해제 후 총 200 MiB
# 분석 대상 PE 수는 BACKEND_MAX_BATCH_FILES 상한을 함께 적용합니다.
# BACKEND_MAX_ZIP_BYTES=52428800
# BACKEND_MAX_ZIP_ENTRIES=100
# BACKEND_MAX_ZIP_EXPANDED_BYTES=209715200
# 항목별 압축률 제한. 제외 대상도 선언된 총량·압축률 검사에 포함합니다.
# BACKEND_MAX_ZIP_RATIO=200
# ZIP 검사·해제 처리 시간. HTTP 업로드 시간 제한과는 별도입니다.
# BACKEND_ZIP_TIMEOUT_SECONDS=60
# BACKEND_UPLOAD_TIMEOUT_SECONDS=120
# BACKEND_DOWNLOAD_TIMEOUT_SECONDS=60
# BACKEND_EXTRACTION_TIMEOUT_SECONDS=30
# BACKEND_INFERENCE_TIMEOUT_SECONDS=120
# BACKEND_XAI_TIMEOUT_SECONDS=30
# BACKEND_SHAP_TOP_K=5
# BACKEND_POLL_SECONDS=3
# BACKEND_DEEP_WAIT_SECONDS=86400
# 보관 기간은 시간 단위입니다. 실제 삭제는 cleanup --delete 명령으로 수행합니다.
# BACKEND_RETENTION_HOURS=24

# 7. 심층 분석 — 별도 Deep Analysis·Speakeasy Worker 코드를 통합할 때 사용
# 이 백엔드 브랜치에는 해당 서비스 초안이 포함되어 있지 않습니다.
# 연결하려면 S3 모드와 같은 DB·버킷을 사용하는 서비스/Worker 환경이 필요합니다.
# SQS_QUEUE_URL은 작업 큐, SQS_DLQ_URL은 반복 실패한 작업이 모이는 큐 주소입니다.
# 두 주소는 AWS에서 실제로 만든 서로 다른 큐의 URL로 채웁니다.
# SQS_QUEUE_URL=https://sqs.ap-northeast-2.amazonaws.com/000000000000/trust-triage-speakeasy
# SQS_DLQ_URL=https://sqs.ap-northeast-2.amazonaws.com/000000000000/trust-triage-speakeasy-dlq
# 도구 경로와 별도 Worker의 WORKER_* 설정은 각 서비스 설정에 맞춰 준비합니다.
