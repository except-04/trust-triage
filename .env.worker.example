# Worker 서버 전용 예시. 실제 값은 .env에 넣고 Git에 올리지 않습니다.
# .env가 없을 때: Copy-Item .env.worker.example .env
# 기존 .env가 있으면 필요한 항목만 추가합니다.
# AWS 인증은 서버 IAM 역할 또는 기존 AWS 프로필을 사용합니다.
AWS_REGION=ap-northeast-2
SQS_QUEUE_URL=
SQS_DLQ_URL=

# Backend와 공유할 PostgreSQL DB. 담당자에게 받은 SSL 옵션도 함께 사용합니다.
# 예: postgresql://DB_USER:DB_PASSWORD@DB_HOST:5432/DB_NAME?sslmode=require
WORKER_DATABASE_URL=
WORKER_S3_BUCKET=
# BACKEND_S3_BUCKET/BACKEND_S3_PREFIX와 같은 값을 사용합니다.
# 원본: raw/<sha256>/sample.bin
# 정규화 리포트: raw/<sha256>/analyses/<analysis_id>/speakeasy/<tool_run_id>/report.json
WORKER_S3_PREFIX=raw/
WORKER_TEMP_DIR=artifacts/worker/tmp
WORKER_MAX_FILE_BYTES=52428800
WORKER_POLL_SECONDS=20
WORKER_ANALYSIS_TIMEOUT_SECONDS=30
WORKER_DOWNLOAD_TIMEOUT_SECONDS=60
WORKER_JOB_TIMEOUT_SECONDS=120
WORKER_VISIBILITY_SECONDS=180
WORKER_HEARTBEAT_SECONDS=30
WORKER_RETRY_DELAY_SECONDS=30
# 요청 SQS RedrivePolicy의 maxReceiveCount와 일치해야 합니다.
WORKER_MAX_RECEIVES=3
