# MonoGPT MonoRouter (OpenAI-compatible) settings.
# Copy this file to .env and fill in the values locally.
LLM_ENABLED=true
MONOGPT_API_KEY=
# Use the Base URL shown in the MonoGPT API settings.
# The client appends /chat/completions unless it is already present.
MONOGPT_BASE_URL=
MONOGPT_MODEL=
MONOGPT_TIMEOUT_SECONDS=60
MONOGPT_MAX_TOKENS=1600
MONOGPT_MAX_EVIDENCE_ITEMS=40
MONOGPT_MAX_INPUT_CHARS=24000
